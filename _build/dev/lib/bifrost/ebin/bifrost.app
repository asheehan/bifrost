{application,bifrost,
             [{compile_env,[{bifrost,['Elixir.BifrostWeb.Endpoint',
                                      code_reloader],
                                     {ok,true}},
                            {bifrost,['Elixir.BifrostWeb.Endpoint',
                                      debug_errors],
                                     {ok,true}},
                            {bifrost,['Elixir.BifrostWeb.Endpoint',force_ssl],
                                     error},
                            {bifrost,['Elixir.BifrostWeb.Gettext'],error},
                            {bifrost,[dev_routes],{ok,true}}]},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger,runtime_tools,
                             phoenix,phoenix_ecto,ecto_sql,postgrex,
                             phoenix_html,phoenix_live_reload,
                             phoenix_live_view,phoenix_live_dashboard,esbuild,
                             tailwind,swoosh,req,telemetry_metrics,
                             telemetry_poller,gettext,jason,dns_cluster,
                             bandit]},
              {description,"bifrost"},
              {modules,['Elixir.Bifrost','Elixir.Bifrost.Application',
                        'Elixir.Bifrost.Mailer','Elixir.Bifrost.Repo',
                        'Elixir.BifrostWeb',
                        'Elixir.BifrostWeb.CoreComponents',
                        'Elixir.BifrostWeb.Endpoint',
                        'Elixir.BifrostWeb.ErrorHTML',
                        'Elixir.BifrostWeb.ErrorJSON',
                        'Elixir.BifrostWeb.Gettext',
                        'Elixir.BifrostWeb.Layouts',
                        'Elixir.BifrostWeb.PageController',
                        'Elixir.BifrostWeb.PageHTML',
                        'Elixir.BifrostWeb.Router',
                        'Elixir.BifrostWeb.Telemetry']},
              {registered,[]},
              {vsn,"0.1.0"},
              {mod,{'Elixir.Bifrost.Application',[]}}]}.
