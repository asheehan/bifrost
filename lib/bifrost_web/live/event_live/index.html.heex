<.header>
  My Events
  <:actions>
    <.link patch={~p"/events/new"}>
      <.button>New Event</.button>
    </.link>
  </:actions>
</.header>

<.table id="events" rows={@events}>
  <:col :let={event} label="Name">{event.name}</:col>
  <:col :let={event} label="Slug">{event.slug}</:col>
  <:col :let={event} label="Created">{Calendar.strftime(event.inserted_at, "%b %d, %Y")}</:col>
  <:col :let={event} label="Actions">
    <.link navigate={~p"/events/#{event.slug}"}>View</.link>
  </:col>
</.table>

<.modal :if={@live_action == :new} id="event-modal" show on_cancel={JS.patch(~p"/events")}>
  <.live_component
    module={BifrostWeb.EventLive.FormComponent}
    id={:new}
    title="New Event"
    action={:new}
    event={@event}
    user={@current_scope.user}
    patch={~p"/events"}
  />
</.modal>
